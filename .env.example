# Postgres connection string (Neon or any Postgres). Omit to render the sample layout without live counts.
# After setting this on Vercel, run `npm run db:setup` once against that database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tirtavex

# Admin login password. Omit to disable /admin login.
ADMIN_PASSWORD=

# HMAC secret for the httpOnly admin session cookie. Use a long random string.
ADMIN_SESSION_SECRET=

# Bearer token for /api/agent/* (external automation).
AGENT_API_KEY=

# Bearer token for /api/cron/refresh. Vercel Cron sends Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Vercel Blob read/write token. Omit to keep image fields as pasted URLs only.
BLOB_READ_WRITE_TOKEN=

# Public site origin used for canonical URLs and sitemap. No trailing slash.
# Leave blank to use https://tirtavex.vercel.app.
NEXT_PUBLIC_SITE_URL=

# Metrics source: fxtwitter (default) or manual.
METRICS_PROVIDER=fxtwitter

# Optional privacy-friendly analytics (Plausible). Leave empty to use first-party beacons only.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Optional webhook that receives collab-brief JSON after it is stored.
CONTACT_WEBHOOK_URL=
