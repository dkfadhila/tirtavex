    "db:setup": "tsx scripts/migrate.ts && tsx scripts/seed.ts",
    "test": "tsx --test lib/*.test.ts"
  },
  "overrides": {
    "zod": "4.6.7"
  },
  "dependencies": {
    "@vercel/blob": "^2.9.0",
    "drizzle-orm": "^0.45.4",
    "gsap": "^3.13.0",
    "lenis": "^1.3.27",
    "motion": "^14.12.0",
    "next": "^16.4.6",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
